# Copy to .env.local for local dev; set the same two vars in Netlify > Site settings > Environment variables.
# Supabase Dashboard > Project Settings > API. Only the URL and the anon/publishable key, NEVER the service_role key or DB URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
